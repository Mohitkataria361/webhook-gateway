# Webhook Delivery & Inspection Gateway

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=webhook_user
DB_PASSWORD=webhook_pass
DB_NAME=webhook_gateway

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# App Config
API_PORT=8080
WORKER_CONCURRENCY=10
MAX_RETRIES=5
BASE_DELAY_MS=1000
CIRCUIT_BREAKER_THRESHOLD=50
CIRCUIT_BREAKER_WINDOW=100
CIRCUIT_BREAKER_OPEN_DURATION_MIN=15

# Auth & OAuth
JWT_SECRET=webhook-gateway-jwt-secret-key-32bytes-min
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# GitHub OAuth (Optional for local dev, Demo login works without credentials)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (Optional for local dev, Demo login works without credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
